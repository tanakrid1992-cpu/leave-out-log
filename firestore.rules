rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leave_out_logs/{id} {
      // ทุกคนบันทึกได้ (ตรวจรูปแบบข้อมูล) / อ่าน-ลบ เฉพาะผู้ดูแลที่ล็อกอิน
      allow create: if request.resource.data.keys().hasOnly(['name','position','division','purpose','place','date','timeOut','timeIn','durationMin','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 120
        && request.resource.data.division in ['สำนักปลัดเทศบาล','กองคลัง','กองช่าง','กองการศึกษา','กองสาธารณสุขและสิ่งแวดล้อม','กองสวัสดิการสังคม','กองยุทธศาสตร์และงบประมาณ']
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.durationMin is int && request.resource.data.durationMin > 0
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if request.auth != null;
    }
  }
}
